DISCORD_TOKEN=your-bot-token
ANTHROPIC_API_KEY=sk-ant-...
# optional
GUILD_ID=123456789012345678
FLOOR_CHANNEL=agent-floor
STATE_PATH=state.json
# optional: Cubbie bridge. numeric id from the #agent-floor webhook URL
# (https://discord.com/api/webhooks/<THIS_ID>/<token>). empty = bridge off.
BRIDGE_WEBHOOK_ID=
# optional: ntfy.sh relay, for when Discord blocks the webhook from Cubbie's servers.
# a long random topic name, e.g. bailout-<random>. the Skill saves the same name as
# BAILOUT_RELAY_TOKEN. anyone who knows it can start a bailout, so keep it secret. empty = relay off.
RELAY_TOPIC=
# optional: default players for /seed, so it can run with no mentions (discord user ids)
SEED_MAYA_ID=
SEED_JORDAN_ID=
SEED_PRIYA_ID=
